# Client-safe Supabase configuration. These values are embedded in the Expo bundle.
# Authorization MUST be enforced by RLS/grants, never by treating this key as secret.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server/worker-only variables are intentionally NOT prefixed with EXPO_PUBLIC_:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
